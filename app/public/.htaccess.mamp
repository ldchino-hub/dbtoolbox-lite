# MAMP / subcarpeta en htdocs — copia sobre public/.htaccess:
#   cp public/.htaccess.mamp public/.htaccess
# Luego edita RewriteBase y FallbackResource: reemplaza YOUR_FOLDER por el nombre
# de la carpeta en htdocs (ej. dbtoolbox-lite-1.0.2).
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /YOUR_FOLDER/public/

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_URI} (^|/)api/ [NC]
RewriteRule ^ index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^ index.html [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
FallbackResource /YOUR_FOLDER/public/index.html
</IfModule>
